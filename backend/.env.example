# Copy to .env for local development. Real environment variables override .env.

PORT=8787
# Prometheus metrics, on a separate port so it is not public by default.
METRICS_ADDR=:9091
LOG_LEVEL=info        # debug | info | warn | error
LOG_FORMAT=text       # text (local) | json (production / log collectors)

# MySQL. parseTime, loc=UTC, time_zone and clientFoundRows are added automatically.
DATABASE_DSN=lostfound:lostfound@tcp(localhost:3306)/lost_and_found

CORS_ORIGINS=*        # comma separated, e.g. https://lostandfound.example.com

ADMIN_PASSWORD=change-me
JWT_SECRET=a-long-random-string   # e.g. `openssl rand -hex 32`
TOKEN_TTL=8h

# S3-compatible storage. Local: MinIO from docker-compose.yml.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=lost-and-found
S3_ACCESS_KEY_ID=devaccesskey
S3_SECRET_ACCESS_KEY=devsecretkey
# Optional public/CDN base URL. Empty: images are streamed through /api/uploads/...
S3_PUBLIC_URL=
