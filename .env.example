# Optional overrides for docker-compose.yml (copy to .env). Every value has a local default.
MYSQL_USER=lostfound
MYSQL_PASSWORD=lostfound
MYSQL_ROOT_PASSWORD=root

MINIO_ROOT_USER=devaccesskey
MINIO_ROOT_PASSWORD=devsecretkey   # at least 8 characters

ADMIN_PASSWORD=change-me
JWT_SECRET=dev-only-jwt-secret-change-me   # e.g. `openssl rand -hex 32`
CORS_ORIGINS=http://localhost:8080
LOG_LEVEL=info

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
